<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- TORNEOS -->
    <xs:element name="torneos">
        <xs:complexType>
            <xs:sequence>

                <xs:element name="torneo" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>

                            <xs:element name="nombre" type="xs:string"/>
                            <xs:element name="fechaInicio" type="xs:date"/>
                            <xs:element name="fechaFin" type="xs:date"/>

                            <xs:element name="partidas">
                                <xs:complexType>
                                    <xs:sequence>

                                        <xs:element name="partida" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:sequence>

                                                    <xs:element name="ronda" type="xs:int"/>
                                                    <xs:element name="mesa" type="xs:int"/>

                                                    <xs:element name="blancas">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="nombre" type="xs:string"/>
                                                                <xs:element name="resultado" type="xs:string"/>
                                                            </xs:sequence>
                                                            <xs:attribute name="jugadorId" type="xs:int" use="required"/>
                                                        </xs:complexType>
                                                    </xs:element>

                                                    <xs:element name="negras">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="nombre" type="xs:string"/>
                                                                <xs:element name="resultado" type="xs:string"/>
                                                            </xs:sequence>
                                                            <xs:attribute name="jugadorId" type="xs:int" use="required"/>
                                                        </xs:complexType>
                                                    </xs:element>

                                                    <xs:element name="arbitro" type="xs:string"/>

                                                    <xs:element name="movimientos">
                                                        <xs:complexType>
                                                            <xs:sequence>

                                                                <xs:element name="movimiento" maxOccurs="unbounded">
                                                                    <xs:complexType>
                                                                        <xs:sequence>
                                                                            <xs:element name="blancas" type="xs:string"/>
                                                                            <xs:element name="negras" type="xs:string"/>
                                                                        </xs:sequence>
                                                                        <xs:attribute name="id" type="xs:int" use="required"/>
                                                                    </xs:complexType>
                                                                </xs:element>

                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>

                                                </xs:sequence>

                                                <xs:attribute name="id" type="xs:int" use="required"/>
                                            </xs:complexType>
                                        </xs:element>

                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>

                        </xs:sequence>

                        <xs:attribute name="id" type="xs:int" use="required"/>
                    </xs:complexType>
                </xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- USUARIOS -->
    <xs:element name="usuarios">
        <xs:complexType>
            <xs:sequence>

                <xs:element name="usuario" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>

                            <xs:element name="nombre" type="xs:string"/>
                            <xs:element name="apellido" type="xs:string"/>
                            <xs:element name="dni" type="xs:string"/>
                            <xs:element name="mail" type="xs:string"/>
                            <xs:element name="telefono" type="xs:string"/>
                            <xs:element name="password" type="xs:string"/>
                            <xs:element name="edad" type="xs:int"/>

                        </xs:sequence>

                        <xs:attribute name="id" type="xs:int" use="required"/>
                    </xs:complexType>
                </xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
